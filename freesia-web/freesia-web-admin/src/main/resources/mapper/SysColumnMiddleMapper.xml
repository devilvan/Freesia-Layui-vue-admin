<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.freesia.mapper.SysColumnMiddleMapper">
    <resultMap id="BaseResultMap" type="com.freesia.po.SysColumnMiddlePo">
        <id column="ID" property="id"/>
        <result column="CREATOR" property="creator"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="MODIFIER" property="modifier"/>
        <result column="MODIFY_TIME" property="modifyTime"/>
        <result column="LOGIC_DEL" property="logicDel"/>
        <result column="REC_VER" property="recVer"/>
        <result column="BUILD_IN" property="buildIn"/>
        <result column="TENANT_ID" property="tenantId"/>
        <result column="HEADER_ID" property="headerId"/>
        <result column="TITLE" property="title"/>
        <result column="NAME" property="name"/>
        <result column="ENABLED" property="enabled"/>
        <result column="CUSTOM_SLOT" property="customSlot"/>
    </resultMap>
    <sql id="Base_Column_List">
        ID, CREATOR, CREATE_TIME, MODIFIER, MODIFY_TIME, LOGIC_DEL, REC_VER, BUILD_IN, TENANT_ID, HEADER_ID, TITLE, NAME, ENABLED, CUSTOM_SLOT
    </sql>
    <select id="findPage" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM SYS_COLUMN_MIDDLE
        WHERE
        LOGIC_DEL = 0
        <if test="dto.headerId != null">
            AND HEADER_ID = #{dto.headerId}
        </if>
        <if test="dto.title != null and dto.title != ''">
            AND TITLE = #{dto.title}
        </if>
        <if test="dto.name != null and dto.name != ''">
            AND NAME = #{dto.name}
        </if>
        <if test="dto.enabled != null and dto.enabled != ''">
            AND ENABLED = #{dto.enabled}
        </if>
        ORDER BY create_time DESC
    </select>
    <select id="findList" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM SYS_COLUMN_MIDDLE
        WHERE LOGIC_DEL = 0
        <if test="dto.headerId != null">
            AND HEADER_ID = #{dto.headerId}
        </if>
        <if test="dto.title != null and dto.title != ''">
            AND TITLE = #{dto.title}
        </if>
        <if test="dto.name != null and dto.name != ''">
            AND NAME = #{dto.name}
        </if>
        <if test="dto.enabled != null and dto.enabled != ''">
            AND ENABLED = #{dto.enabled}
        </if>
        ORDER BY MODIFY_TIME DESC
    </select>
    <select id="findOne" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM SYS_COLUMN_MIDDLE
        WHERE LOGIC_DEL = 0
        <if test="dto.headerId != null">
            AND HEADER_ID = #{dto.headerId}
        </if>
        <if test="dto.title != null and dto.title != ''">
            AND TITLE = #{dto.title}
        </if>
        <if test="dto.name != null and dto.name != ''">
            AND NAME = #{dto.name}
        </if>
        <if test="dto.enabled != null and dto.enabled != ''">
            AND ENABLED = #{dto.enabled}
        </if>
        LIMIT 1
    </select>
    <insert id="insertBatch" parameterType="java.util.List">
        INSERT INTO SYS_COLUMN_MIDDLE
        (
        ID,
        CREATOR,
        CREATE_TIME,
        MODIFIER,
        MODIFY_TIME,
        LOGIC_DEL,
        REC_VER,
        BUILD_IN,
        TENANT_ID,
        HEADER_ID, 
        TITLE, 
        NAME, 
        ENABLED,
        CUSTOM_SLOT
        )
        VALUES
        <foreach collection="list" item="item" separator=",">
            (
            #{item.id},
            #{item.creator},
            #{item.createTime},
            #{item.modifier},
            #{item.modifyTime},
            #{item.logicDel},
            #{item.recVer},
            #{item.buildIn},
            #{item.tenantId},
            #{item.headerId}, 
            #{item.title}, 
            #{item.name}, 
            #{item.enabled},
            #{item.customSlot}
            )
        </foreach>
    </insert>
</mapper>
