<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.freesia.icon.mapper.CommonIconTemplateHeaderMapper">
    <select id="findMaxOrderNum" resultType="java.lang.Integer">
        SELECT MAX(CITH.ORDER_NUM)
        FROM common_icon_template_header CITH
    </select>
    <select id="findExistsDefaultFlag" resultType="java.lang.Boolean">
        SELECT EXISTS(SELECT 1
                      FROM common_icon_template_header
                      WHERE 1 = 1
                        AND LOGIC_DEL = 0
                        AND USER_ID = #{userId}
                        AND DEFAULT_FLAG = 1)
    </select>
</mapper>
