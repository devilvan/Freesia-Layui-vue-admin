<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.freesia.deepseek.mapper.ChatConversationMapper">
    <resultMap id="BaseResultMap" type="com.freesia.deepseek.po.ChatConversationPo">
        <id column="ID" property="id"/>
        <result column="CREATOR" property="creator"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="MODIFIER" property="modifier"/>
        <result column="MODIFY_TIME" property="modifyTime"/>
        <result column="LOGIC_DEL" property="logicDel"/>
        <result column="REC_VER" property="recVer"/>
        <result column="BUILD_IN" property="buildIn"/>
        <result column="TENANT_ID" property="tenantId"/>
        <result column="PROVIDER_CODE" property="providerCode"/>
        <result column="USER_ID" property="userId"/>
        <result column="TITLE" property="title"/>
        <result column="CHAT_MODE" property="chatMode"/>
    </resultMap>
    <sql id="Base_Column_List">
        ID, CREATOR, CREATE_TIME, MODIFIER, MODIFY_TIME, LOGIC_DEL, REC_VER, BUILD_IN, TENANT_ID, PROVIDER_CODE, USER_ID, TITLE, CHAT_MODE
    </sql>
    <select id="findPage" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM CHAT_CONVERSATION
        WHERE
        LOGIC_DEL = 0
        <if test="dto.providerCode != null and dto.providerCode != ''">
            AND PROVIDER_CODE = #{dto.providerCode}
        </if>
        <if test="dto.userId != null">
            AND USER_ID = #{dto.userId}
        </if>
        <if test="dto.title != null and dto.title != ''">
            AND TITLE = #{dto.title}
        </if>
        <if test="dto.chatMode != null and dto.chatMode != ''">
            AND CHAT_MODE = #{dto.chatMode}
        </if>
        ORDER BY create_time DESC
    </select>
    <select id="findList" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM CHAT_CONVERSATION
        WHERE LOGIC_DEL = 0
        <if test="dto.id != null">
            AND ID = #{dto.id}}
        </if>
        <if test="dto.providerCode != null and dto.providerCode != ''">
            AND PROVIDER_CODE = #{dto.providerCode}
        </if>
        <if test="dto.userId != null">
            AND USER_ID = #{dto.userId}
        </if>
        <if test="dto.title != null and dto.title != ''">
            AND TITLE = #{dto.title}
        </if>
        <if test="dto.chatMode != null and dto.chatMode != ''">
            AND CHAT_MODE = #{dto.chatMode}
        </if>
        ORDER BY MODIFY_TIME DESC
    </select>
    <select id="findOne" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM CHAT_CONVERSATION
        WHERE LOGIC_DEL = 0
        <if test="dto.id != null">
            AND ID = #{dto.id}}
        </if>
        <if test="dto.providerCode != null and dto.providerCode != ''">
            AND PROVIDER_CODE = #{dto.providerCode}
        </if>
        <if test="dto.userId != null">
            AND USER_ID = #{dto.userId}
        </if>
        <if test="dto.title != null and dto.title != ''">
            AND TITLE = #{dto.title}
        </if>
        <if test="dto.chatMode != null and dto.chatMode != ''">
            AND CHAT_MODE = #{dto.chatMode}
        </if>
        LIMIT 1
    </select>
    <insert id="insertBatch" parameterType="java.util.List">
        INSERT INTO CHAT_CONVERSATION
        (
        ID,
        CREATOR,
        CREATE_TIME,
        MODIFIER,
        MODIFY_TIME,
        LOGIC_DEL,
        REC_VER,
        BUILD_IN,
        TENANT_ID,
        PROVIDER_CODE, 
        USER_ID, 
        TITLE, 
        CHAT_MODE
        )
        VALUES
        <foreach collection="list" item="item" separator=",">
            (
            #{item.id},
            #{item.creator},
            #{item.createTime},
            #{item.modifier},
            #{item.modifyTime},
            #{item.logicDel},
            #{item.recVer},
            #{item.buildIn},
            #{item.tenantId},
            #{item.providerCode}, 
            #{item.userId}, 
            #{item.title}, 
            #{item.chatMode}
            )
        </foreach>
    </insert>
</mapper>
